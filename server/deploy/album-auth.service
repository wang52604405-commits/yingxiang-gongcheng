[Unit]
Description=工程影像管理平台 账号与授权中心
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/album-auth
Environment="ALBUM_SERVER_HOST=127.0.0.1"
Environment="ALBUM_SERVER_PORT=8000"
Environment="ALBUM_SERVER_DATA=/opt/album-auth/data"
Environment="ALBUM_SERVER_PRIVATE_KEY=/etc/album-auth/private_key.pem"
Environment="ALBUM_MOBILE_STORAGE_DIR=/opt/album-auth/data/mobile_objects"
Environment="ALBUM_MOBILE_CHUNK_DIR=/opt/album-auth/data/mobile_chunks"
EnvironmentFile=/etc/album-auth/server.env
EnvironmentFile=-/etc/album-auth/mobile.env
ExecStart=/opt/album-auth/venv/bin/gunicorn --no-control-socket --worker-class gthread -w 1 --threads 4 --timeout 300 -b 127.0.0.1:8000 "server.app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
