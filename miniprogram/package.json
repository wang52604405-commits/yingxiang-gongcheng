{
  "name": "engineering-image-miniprogram",
  "version": "1.5.1",
  "private": true,
  "description": "工程影像微信小程序 V1.5：批量采集、照片草稿与流畅上传",
  "scripts": {
    "dev:mp-weixin": "cross-env VITE_API_MODE=real uni -p mp-weixin",
    "dev:mp-weixin:mock": "uni -p mp-weixin --mode mock",
    "build:mp-weixin": "cross-env VITE_API_MODE=real node scripts/build-mp-weixin.mjs",
    "build:mp-weixin:release": "cross-env VITE_API_MODE=real REQUIRE_WECHAT_APP_ID=1 node scripts/build-mp-weixin.mjs",
    "dev:h5": "uni -p h5 --mode mock",
    "build:h5": "uni build -p h5 --mode mock",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813001",
    "@dcloudio/uni-components": "3.0.0-5020420260813001",
    "@dcloudio/uni-h5": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813001",
    "@types/node": "22.13.10",
    "cross-env": "7.0.3",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vitest": "3.2.6",
    "vue-tsc": "2.2.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
