{
  "name": "工程影像",
  "appid": "__UNI__ENGINEERING_IMAGE_V1",
  "description": "水利、房建、市政、电力工程现场影像采集、同步与归档",
  "versionName": "1.6.4",
  "versionCode": "164",
  "transformPx": false,
  "mp-weixin": {
    "appid": "",
    "libVersion": "2.25.0",
    "setting": {
      "urlCheck": true,
      "es6": true,
      "postcss": true,
      "minified": true,
      "__usePrivacyCheck__": true
    },
    "usingComponents": true,
    "requiredPrivateInfos": [
      "getLocation",
      "chooseLocation"
    ],
    "permission": {
      "scope.camera": {
        "desc": "用于拍摄现场工程影像"
      },
      "scope.userLocation": {
        "desc": "用于现场照片水印定位，以及按所在地日出日落切换白天与夜间界面"
      },
      "scope.writePhotosAlbum": {
        "desc": "仅在您点击保存水印照片时，将生成的照片副本保存到手机相册"
      }
    }
  }
}
