.tabbar {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  height: calc(126rpx + env(safe-area-inset-bottom));
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid #2b4247;
  background: #122024;
  box-shadow: 0 -12rpx 30rpx rgba(0, 0, 0, 0.16);
}
.tab-button {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 100%;
  height: 100%;
  min-width: 0;
  overflow: visible;
  margin: 0;
  padding: 0;
  color: #82979a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
  line-height: 1;
  text-align: center;
  background: transparent;
  border: 0;
  transform: scale(1);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), opacity 140ms cubic-bezier(0.23, 1, 0.32, 1);
}
.tab-button::after { border: 0; }
.tab-button.pressed { transform: scale(0.97); }
.tab-button.active { color: #42d7c2; }
.icon-wrap { position: relative; display: grid; place-items: center; width: 52rpx; height: 52rpx; }
.line-icon { position: relative; display: block; width: 38rpx; height: 38rpx; color: currentColor; }
.part { position: absolute; box-sizing: border-box; }
.icon-camera .part-a { inset: 19% 8% 12%; border: 3rpx solid currentColor; border-radius: 22%; }
.icon-camera .part-b { left: 34%; top: 35%; width: 32%; height: 32%; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-camera .part-c { left: 23%; top: 10%; width: 28%; height: 19%; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 22% 22% 0 0; }
.icon-home .part-a { left: 17%; top: 31%; width: 66%; height: 55%; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 15% 15%; }
.icon-home .part-b { left: 20%; top: 13%; width: 60%; height: 60%; border-top: 3rpx solid currentColor; border-left: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 8%; }
.icon-home .part-c { left: 44%; bottom: 14%; width: 18%; height: 30%; border: 3rpx solid currentColor; border-bottom: 0; }
.icon-gallery .part-a { inset: 20% 8% 10% 20%; border: 3rpx solid currentColor; border-radius: 12%; }
.icon-gallery .part-b { left: 8%; top: 8%; width: 70%; height: 70%; border: 3rpx solid currentColor; border-radius: 12%; }
.icon-gallery .part-c { left: 28%; bottom: 25%; width: 43%; height: 30%; border-left: 3rpx solid currentColor; border-top: 3rpx solid currentColor; transform: rotate(45deg) skew(-8deg, -8deg); }
.icon-upload .part-a { left: 8%; right: 8%; bottom: 8%; height: 48%; border: 3rpx solid currentColor; border-radius: 48% 48% 30% 30%; border-top-color: transparent; }
.icon-upload .part-b { left: 48%; top: 8%; width: 3rpx; height: 62%; background: currentColor; }
.icon-upload .part-c { left: 35%; top: 11%; width: 28%; height: 28%; border-left: 3rpx solid currentColor; border-top: 3rpx solid currentColor; transform: rotate(45deg); }
.icon-user .part-a { left: 35%; top: 8%; width: 30%; height: 30%; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-user .part-b { left: 16%; bottom: 8%; width: 68%; height: 43%; border: 3rpx solid currentColor; border-radius: 50% 50% 18% 18%; }
.icon-user .part-c { display: none; }
.tab-label { display: block; width: 100%; font-size: 22rpx; font-weight: 500; line-height: 1.2; text-align: center; }
.tab-button.primary { justify-content: center; height: calc(100% + 36rpx); margin-top: -36rpx; transform-origin: center bottom; }
.tab-button.primary .icon-wrap { position: absolute; top: 0; left: 50%; width: 86rpx; height: 86rpx; border: 8rpx solid #122024; border-radius: 28rpx; color: #041a1a; background: #42d7c2; box-shadow: 0 14rpx 28rpx rgba(45, 185, 170, 0.28); box-sizing: border-box; transform: translateX(-50%); }
.tab-button.primary .line-icon { width: 42rpx; height: 42rpx; }
.tab-button.primary .tab-label { position: absolute; top: 102rpx; left: 0; right: 0; margin: 0; color: #42d7c2; }
.badge { position: absolute; top: -6rpx; right: -9rpx; display: grid; place-items: center; min-width: 30rpx; height: 30rpx; padding: 0 7rpx; border: 3rpx solid #122024; border-radius: 999rpx; box-sizing: border-box; color: #241700; background: #f1b34b; font-size: 18rpx; font-weight: 700; }
@media (prefers-reduced-motion: reduce) {
  .tab-button { transition: opacity 1ms linear; }
  .tab-button.pressed { transform: none; opacity: 0.78; }
}
